# Unmask — environment template
# Copy this file to `.env` in the same folder before first run:
#   copy .env.example .env
# Never commit the real .env.
#
# Exactly one .env, here at the project root (UNMASK\.env). The API loads it by
# path, so it works however it is started. api\.env would be ignored.

# ---- The database container (docker-compose.yml reads these) ----
# Only used while the database is a container on this machine. Point MONGO_URL at a
# hosted database below and these two lines are decoration.
MONGO_USER=unmask
# A local-only password. Any string that is not this default is fine.
MONGO_PASSWORD=change-me-local-only

# ---- The API ----
PORT=4100
# The container's address, for a database on this machine.
MONGO_URL=mongodb://unmask:change-me-local-only@127.0.0.1:27017/unmask?authSource=admin
# A hosted database replaces the line above with a `mongodb+srv://` string copied
# from the provider — Atlas prints it at Database > Connect > Connect your
# application. Three things about it are not obvious and all three fail silently:
#   - the driver's address must be on the provider's IP allow list, and a laptop on
#     campus gets a new address most days, so "Network is unreachable" from a
#     database that worked this morning is that list, not the password;
#   - `?authSource=admin` says which database the user lives in. Atlas does not need
#     it (its own users authenticate against `admin` by default), but a self-hosted
#     Mongo whose account was created somewhere else refuses every login as if the
#     password were wrong without it;
#   - the string has to name a database. Atlas prints `…mongodb.net/?appName=…` with
#     nothing before the `?`, and MongoDB then quietly opens a database called `test`
#     — the site boots, logs in, and saves everything somewhere the backup script
#     never looks. Type `/unmask` in there, before the first `?`.
# Nothing else in this build cares which of the two it is: `+srv` is resolved and
# handshaked like any other address, and the backup and restore scripts read the
# database name out of the same string.
# Signs login cookies. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Where the browser is allowed to call the API from, comma separated. Since stage
# 9d this same list is what the chat socket's handshake is checked against: when the
# API also serves the site (below), the site's own public origin has to appear here,
# or every student loads the page and the Live badge never turns green.
WEB_ORIGIN=http://localhost:5273
# How many proxies sit in front of the API. Leave it at 0 (or unset) while this
# machine is the whole deployment: that is what stops a client naming its own
# address in X-Forwarded-For and choosing which rate-limit bucket it spends.
# Set it to 1 when a host (Render, Railway, a load balancer) terminates HTTPS for
# you — with 0 there, every student arrives as one address and one busy person can
# lock the whole site out of logging in.
TRUST_PROXY_HOPS=0
# Should this process also serve the built site? One origin for the page, the JSON
# and the socket is what keeps the session cookie first-party and needs no CORS.
# Unset means: serve it if web\dist exists, which is true the moment anyone runs
# `npm run build`. Set 0 to keep the API JSON-only and run the web app separately.
SERVE_WEB=
# Where that build is, relative to this file's folder. Only read when SERVE_WEB is on.
WEB_DIST=./web/dist

# ---- Student email verification ----
# Which domains may register is no longer kept here. It is a row per institution in
# the database (the `institutions` collection), and a staff member adds or removes a
# college at /staff without touching this file or redeploying. The institutions this
# build ships with are listed in api/src/domain/pilotInstitutions.js, and `npm run
# institutions` writes them in.
# Leave SMTP_HOST empty while developing: the confirmation code is then written to
# api/outbox/ instead of being emailed. Nothing verifies until someone opens that
# file and types the six digits in, so there is no bypass — but a real server must
# not run this way, and `NODE_ENV=production` refuses to start with it empty.
#
# The free plan that works today is Brevo: 300 emails a day, free, no card, SMTP
# relay included. Sign up, verify the sender address below, then set:
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   SMTP_USER=<that same address>    SMTP_PASSWORD=<the key from "SMTP & API" —
#   a 32-character key, not your login password>
# Gmail and Outlook personal addresses cannot be used here: both stopped accepting
# plain password SMTP, and a message from an address they do not send for is dropped
# or lands in spam. A university relay, if yours will relay for you, is better still.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be a domain you can send from, and must not name an institution — this
# address is in every email a student receives.
MAIL_FROM=Unmask <no-reply@unmask.example>
PUBLIC_APP_URL=http://localhost:5273
# Optional. Only used while SMTP_HOST is empty — the folder those codes are
# written to, relative to the api\ folder. The default is ./outbox.
OUTBOX_DIR=./outbox

# Set to 1 to stop the six digits being the thing between "create account" and "signed in":
# registering confirms the address on the spot, nothing is written to api/outbox, and
# signing in with a correct password confirms an address left pending from before you
# turned it on. The password check is untouched — a wrong password is still refused,
# and /api/auth/register still hands out no session — so this is a shortcut through
# the mailbox, not through the login.
#
# It cannot reach a real deployment: NODE_ENV=production refuses to start the API while
# it is on (that is one of the boot gates), and NODE_ENV=test ignores it, so no suite's
# result depends on whether this line is here. Leave it off unless it is your own
# machine and you are tired of opening files in api/outbox.
DEV_AUTO_VERIFY=0

# ---- Demo accounts (optional) ----
# `npm run seed` writes five throwaway, already-verified sign-ins — demo1@ to
# demo4@ plus staff1@, all on the first institution's domain — so the site can be
# clicked through without waiting for an email. This is their password; it
# defaults to "unmask-demo-2026" if you leave it blank. The seeder refuses to
# run when NODE_ENV is production.
DEMO_PASSWORD=

# ---- Profile photos ----
# Where the bytes live. "disk" is this machine's PHOTO_DIR folder — the right answer
# while developing, and the wrong one the moment the site has to survive the laptop
# being closed, moved to another machine, or reinstalled.
#   disk — files under PHOTO_DIR. Nothing else to configure.
#   r2   — objects in a private Cloudflare R2 bucket, written and read by the API
#           over the S3 API. Any other value is refused at boot rather than guessed
#           at, because a photo store that silently fell back to disk would put
#           students' pictures back on the laptop it was supposed to leave.
PHOTO_STORE=disk

# Only read when PHOTO_STORE=disk. Photos are written here, NOT inside the folder the
# web server serves: the API is the only thing that reads them, and only after a
# mutual reveal. Putting it inside WEB_DIST would publish every picture at a URL that
# needs no session and no reveal — boot refuses it for that reason.
PHOTO_DIR=./storage/photos

# ---- Photos in Cloudflare R2 (only read when PHOTO_STORE=r2) ----
# The bucket's endpoint: R2 dashboard > Overview > Bucket details > S3 API, the
# "Endpoint" that reads https://<account-id>.r2.cloudflarestorage.com. Leave this
# empty and set R2_ACCOUNT_ID instead — the API builds the same address from it.
# If you paste the bucket onto the end of the address (…/unmask-storage), that last
# part is picked up as the bucket name, so the two lines below may be left as they are.
R2_ENDPOINT=
R2_ACCOUNT_ID=
# The bucket's name. Connect no custom domain to it: an R2 object has no public URL
# unless one is attached, and the API streams the bytes out itself after checking a
# mutual reveal happened, so a bucket reachable without a signature would only add a
# second way in with no checks at all.
R2_BUCKET=unmask-storage
# The Access Key ID + Secret Access Key pair from R2 overview > Account Details >
# API Tokens > Manage > Create Account API token, with the Object Read & Write
# permission scoped to that one bucket. The secret is shown once, at creation.
# These are NOT the `cfat_` token the Cloudflare dashboard hands out for account
# management — an S3 request signed with that one is refused, and the refusal looks
# like a permissions error rather than the wrong kind of key.
# The secret half is, on its own, the whole bucket: it can read and delete every
# student's picture. So it lives here and nowhere else — never in web/, never in a
# git-tracked file, never in a browser, never in a chat window.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. How long a single storage request may take before the API gives up on it,
# in milliseconds; default 8000. Without it a provider that stops answering would pin
# an authenticated request open indefinitely, and the whole site would appear to
# hang on somebody's profile picture.
R2_TIMEOUT_MS=8000
