node_modules/
.env
.env.*
!.env.example
deploy/prod.env
.DS_Store
npm-debug.log*

# Profile photos and confirmation codes are personal data. Never committed.
# A backup folder is the whole database plus every photo, in plain files. Of all the
# things in this repository it is the one that must never be committed.
storage/
api/storage/
outbox/
api/outbox/
backups/
api/backups/

dist/
web/dist/

# Local run output. A suite log quotes folder paths and the addresses of the accounts
# it created; it is read on the machine that wrote it and nowhere else. A glob, because
# these files are written under whatever name the person running them typed.
*.log
api/*.log
