# Copy this to deploy/prod.env on the server, fill it in, and keep it out of git — it
# holds the database password and the key that signs every login cookie. The root .env
# file is the development version of the same list; `docker compose --env-file` reads
# this one, and nothing here is read by a laptop run.
#
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/prod.env up -d --build
#
# Every value below is a secret, an address, or a choice of where a photo is written.
# There are no tune-ables: the API's own boot gates refuse anything else, and each gate
# says which key to edit and what breaks without it.

# ---- the database -------------------------------------------------------------
# The connection string, exactly as the provider's console prints it. This is the one
# line that decides whether the site's data lives on this server or somewhere else:
# nothing in the build distinguishes a hosted MongoDB from the container below.
#
#   hosted (Atlas and the like)   mongodb+srv://user:password@cluster0.xxxx.mongodb.net/unmask?retryWrites=true&w=majority
#   on this server                mongodb://unmask:password@mongo:27017/unmask?authSource=admin
#                                 — and start it with `--profile local-db`, or nothing
#                                   answers on that name
#
# It has to name a database (`/unmask`), not just a server: the backup script reads the
# name out of this string and writes it in the manifest, and a restore is checked against
# that count. Two details fail silently if they are wrong — the address must be on the
# provider's allow list, and `authSource` must stay as the provider gives it.
MONGO_URL=

# Only used by the `local-db` profile's container, which creates this account on its very
# first start and cannot be told a different one afterwards without editing the
# deployment by hand. Choose the password before the first `up` with that flag; with a
# hosted database these two lines are unread.
MONGO_USER=unmask
MONGO_PASSWORD=

# ---- the profile photos -------------------------------------------------------
# Where a profile photo is written. `r2` keeps the bytes off this server, which is the
# point once the container that held them can be switched off, rebuilt or moved;
# `disk` writes them under api/storage/photos in the container's mounted volume, and
# an image rebuild then deletes every picture with it.
# Anything else is refused at boot rather than quietly treated as disk.
PHOTO_STORE=r2

# Read only when PHOTO_STORE=r2. The endpoint is on the bucket's Overview page
# (https://<account-id>.r2.cloudflarestorage.com) — or set R2_ACCOUNT_ID and let the
# API build it. Pasting the bucket onto the end of the endpoint works too; the last
# path part is then taken as R2_BUCKET.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_BUCKET=unmask-storage
# The bucket's own S3 API credentials — Access Key ID and Secret Access Key, issued
# beside the endpoint. These are NOT the `cfat_` account-management token; an S3
# request signed with that one is refused. The secret half is, by itself, write and
# read access to every student's picture, so it belongs in this file and in no other,
# never in the site's own code and never in a browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TIMEOUT_MS=8000

# ---- the address students type -----------------------------------------------
# Must start with https:// — the session cookie is marked Secure, so over plain HTTP a
# browser stores it and then refuses to send it, and every login looks like a wrong
# password. This one value also becomes WEB_ORIGIN, which is both the browser allowlist
# and the chat socket allowlist, so it has to be exactly what the browser shows.
PUBLIC_APP_URL=https://unmask.example.ac.za

# Which loopback port the proxy forwards to. Leave it alone on a server; set it when
# something on this machine already holds 4100 — a rehearsal on a developer's laptop,
# for instance, where the development API is running.
API_HOST_PORT=4100

# ---- the key that signs login cookies ----------------------------------------
# 64 hex characters. Losing it signs every existing cookie invalid, which signs every
# student out — annoying, not dangerous. Sharing it with another environment lets that
# environment forge a session into this one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- the mail that confirms a student ----------------------------------------
# Without these the API will not start in production: registration ends in a link, and
# a link that goes nowhere means nobody can finish signing up, quietly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Unmask <no-reply@unmask.example.ac.za>
